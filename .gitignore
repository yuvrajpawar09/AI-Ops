# ---------------------------------------------------------------------------
# Local infrastructure state
# ---------------------------------------------------------------------------
# The committed docker-compose.yml deliberately gives Kafka/Zookeeper NO bind
# mounts (their state is disposable and rebuilt on every `up`), so none of these
# directories exist today. They are listed defensively in case persistence is
# added later - broker/ZK data must never be committed.
kafka-data/
kafka-logs/
zookeeper-data/
zookeeper-logs/
zk-data/
data/kafka/
data/zookeeper/
# Ollama models are pulled at runtime into a named Docker volume (GBs) -
# never into the repo.
ollama-models/
docker-compose.override.yml

# ---------------------------------------------------------------------------
# Trained model artifacts  (anomaly-detector/models/)
# ---------------------------------------------------------------------------
# Everything in models/ is ignored by default so stray experiment output never
# gets committed by accident, then the three artifacts a fresh clone actually
# needs are whitelisted back in. All three are required together:
#   - lstm_autoencoder.pt : the trained LSTM autoencoder weights (~67 KB)
#   - threshold.json      : the anomaly cutoff; scorer.try_load_scorer() returns
#                           None without it, silently disabling ALL detection
#   - drain3_state.bin    : the Drain3 cluster tree (~1.4 KB). Template IDs must
#                           match the ones the model was trained on - without it
#                           Drain3 renumbers clusters from scratch and the
#                           trained embeddings become meaningless
anomaly-detector/models/*
!anomaly-detector/models/.gitkeep
!anomaly-detector/models/lstm_autoencoder.pt
!anomaly-detector/models/threshold.json
!anomaly-detector/models/drain3_state.bin
