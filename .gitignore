target/
build/
*.class
*.jar
*.war
*.ear
# Keep the Maven wrapper jar committed if one is ever added - it is required
# for `./mvnw` to bootstrap on a fresh clone.
!.mvn/wrapper/maven-wrapper.jar
# Maven's own scratch output
release.properties
dependency-reduced-pom.xml
pom.xml.versionsBackup
pom.xml.tag
pom.xml.next
pom.xml.releaseBackup

