# Copy this file to .env before the first `docker compose up`:
#
#     cp .env.example .env
#
# Then replace every value below. Each service validates its own secrets at
# startup and refuses to boot if one is missing, too short, or still a
# placeholder, so the stack will not come up with these example values.
#
# .env is gitignored. .env.example is committed, so never put a real secret here.

# Signs the session JWT that rca-agent issues and anomaly-detector verifies.
# Both services must see the same value. At least 32 characters.
#   openssl rand -hex 32
JWT_SECRET=change-me-with-openssl-rand-hex-32

# Shared key for service-to-service calls: rca-agent's playbooks use it to
# reach order-service /admin/config and inventory-service /admin/restock and
# /admin/inventory, and the benchmark scripts use it for the same endpoints.
# At least 16 characters.
#   openssl rand -hex 24
SERVICE_API_KEY=change-me-with-openssl-rand-hex-24

# The first ADMIN account, seeded into the SQLite users table only when the
# table is empty. Changing these later does not alter an existing account -
# use the dashboard's Users page instead. Password needs at least 8 characters.
ADMIN_USERNAME=admin-change-me
ADMIN_PASSWORD=change-me-too

# Optional. Session lifetime in minutes (default 30).
#JWT_TTL_MINUTES=30

# Optional. Set to true only when serving the dashboard over HTTPS; over plain
# http a Secure cookie is dropped by the browser and login silently fails.
#SESSION_COOKIE_SECURE=false
